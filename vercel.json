{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog", "destination": "/pages/blogs/", "permanent": true },
    { "source": "/blog/(.*)", "destination": "/blogs/$1", "permanent": true },
    { "source": "/blogs", "destination": "/pages/blogs/", "permanent": true },
    { "source": "/about", "destination": "/pages/about/", "permanent": true },
    { "source": "/contact", "destination": "/pages/contact/", "permanent": true },
    { "source": "/work", "destination": "/pages/work/", "permanent": true },
    { "source": "/case-studies", "destination": "/pages/case-studies/", "permanent": true },
    { "source": "/services", "destination": "/pages/services/brand-strategy/", "permanent": true },
    { "source": "/industries", "destination": "/pages/industries/service-base/", "permanent": true }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/pages/404/index.html" }
  ]
}
