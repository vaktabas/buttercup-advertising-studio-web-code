# Apache & LiteSpeed High-Traffic Optimization Configuration
# Buttercup Advertising Studio

# 0. Clean URL 301 Redirects & API Rewrites (Hostinger / Apache / LiteSpeed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0a. Legacy Home / Index variations
  RewriteRule ^home/?$ / [R=301,L,NC]
  RewriteRule ^index\.php/?$ / [R=301,L,NC]

  # 1. Google SEO: /blog and /blog/ go to Home Page (or Blogs)
  RewriteRule ^blog/?$ https://buttercup.in/ [R=301,L,NC]

  # 2. Individual articles /blog/xyz -> /blogs/xyz ONLY if target file exists, else /pages/blogs/
  RewriteCond %{DOCUMENT_ROOT}/blogs/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/blogs/$1.html -f
  RewriteRule ^blog/(.+)$ /blogs/$1 [R=301,L,NC]
  RewriteRule ^blog/.+$ /pages/blogs/ [R=301,L,NC]

  # 3. Blogs listing & missing blog slugs / WordPress archive slugs -> /pages/blogs/
  RewriteRule ^blogs/?$ /pages/blogs/ [R=301,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^blogs/.+$ /pages/blogs/ [R=301,L,NC]
  RewriteRule ^(insights|articles|journal|news|category|tag|author)(/.*)?$ /pages/blogs/ [R=301,L,NC]

  # 4. Case Studies, Projects, Work & Portfolio variations (including removed/legacy slugs)
  RewriteRule ^(casestudies|case-studies|case-study|casestudy|our-work|clients)(/.*)?$ /pages/case-studies/ [R=301,L,NC]
  RewriteRule ^(work|works|portfolio|project)/?$ /pages/work/ [R=301,L,NC]
  RewriteRule ^(work|works|portfolio|project)/.+$ /pages/case-studies/ [R=301,L,NC]
  RewriteRule ^projects/?$ /pages/case-studies/ [R=301,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^projects/.+$ /pages/case-studies/ [R=301,L,NC]

  # 5. About, Studio, Team & Contact legacy variations
  RewriteRule ^(about|about-us|who-we-are|studio|agency|team|careers|career)(/.*)?$ /pages/about/ [R=301,L,NC]
  RewriteRule ^(contact|contact-us|get-in-touch|quote|get-a-quote|inquiry|enquiry)(/.*)?$ /pages/contact/ [R=301,L,NC]

  # 6. Services legacy variations (mapped to exact pillar page)
  RewriteRule ^(services/)?(visual-identity|packaging|packaging-design|logo-design|logo|graphic-design|brochure|brochure-design|catalogue|brand-identity|identity)(/.*)?$ /pages/services/visual-identity/ [R=301,L,NC]
  RewriteRule ^(services/)?(marketing-communication|marketing|advertising|digital-marketing|social-media|campaigns|paid-campaigns|brand-shoots|photography|copywriting)(/.*)?$ /pages/services/marketing-communication/ [R=301,L,NC]
  RewriteRule ^(services|service|our-services|brand-strategy|branding|rebranding|naming|positioning|brand-architecture)(/.*)?$ /pages/services/brand-strategy/ [R=301,L,NC]

  # 7. Industries legacy variations
  RewriteRule ^(industries/)?(product-base|products|fmcg|food-and-beverages)(/.*)?$ /pages/industries/product-base/ [R=301,L,NC]
  RewriteRule ^(industries|industry|sectors|service-base)(/.*)?$ /pages/industries/service-base/ [R=301,L,NC]

  # 8. Pricing & Legal pages
  RewriteRule ^pricing(/.*)?$ /pages/pricing/ [R=301,L,NC]
  RewriteRule ^(terms|terms-and-conditions|terms-of-service)(/.*)?$ /pages/terms/ [R=301,L,NC]
  RewriteRule ^(privacy|privacy-policy|licenses)(/.*)?$ /utilities/licenses.html [R=301,L,NC]

  # 9. Agent Content Negotiation: Serve Markdown when Accept header requests text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{REQUEST_URI} ^/?$ [OR]
  RewriteCond %{REQUEST_URI} ^/index(\.html)?$
  RewriteRule ^.*$ /index.md [L,T=text/markdown;charset=UTF-8]

  # Clean URLs without .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # API Endpoints
  RewriteRule ^api/save-content/?$ api/save-content.php [QSA,L]
  RewriteRule ^api/reset-content/?$ api/reset-content.php [QSA,L]
  RewriteRule ^api/track-visitor/?$ api/track-visitor.php [QSA,L]
</IfModule>

# Allow access to .well-known directory
<IfModule mod_rewrite.c>
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# Prevent CDN caching on dynamic customizations, sitemaps, and API
<FilesMatch "\.(xml|txt|json|php)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# 1. Enable GZIP & Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/markdown
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf font/opentype font/ttf font/otf font/woff font/woff2 image/x-icon
</IfModule>

# 2. Browser & CDN Cache Expiration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & SVGs: 1 Year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 Year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"

  # Videos: 1 Year
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # CSS & JS: 1 Month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"

  # HTML & Markdown: Fresh delivery
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/markdown "access plus 0 seconds"
</IfModule>

# 3. Security Headers, RFC 8288 Link Headers & CORS
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Browser & Edge Caching for Static Assets
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg|woff|woff2|ttf|otf|eot|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # RFC 8288 Link headers on homepage for AI Agents
  SetEnvIf Request_URI "^/(index\.html)?$" HOMEPAGE_LINK=1
  Header set Link '</llms.txt>; rel="describedby"; type="text/markdown", </index.md>; rel="alternate"; type="text/markdown"' env=HOMEPAGE_LINK

  # CORS for MCP Server Card and LLM Resources
  <FilesMatch "^(server-card\.json|llms\.txt|llms-full\.txt|index\.md)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Accept"
  </FilesMatch>
</IfModule>

# MIME Types for Agent Resources
<IfModule mod_mime.c>
  AddType text/markdown;charset=UTF-8 .md
  AddType text/plain;charset=UTF-8 .txt
  AddType application/json;charset=UTF-8 .json
</IfModule>

# 4. Custom 404 Error Page
ErrorDocument 404 /pages/404/index.html
